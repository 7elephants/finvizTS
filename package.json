{
  "name": "finvizts",
  "version": "2.1.0",
  "description": "Unofficial TypeScript client for the Finviz Elite API",
  "author": "Andrew Steiger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7elephants/finvizTS.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:live": "jest --testPathIgnorePatterns=/node_modules/ --runInBand tests/live",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "finviz",
    "finviz-api",
    "finviz-elite",
    "stock",
    "stocks",
    "stock-market",
    "stock-screener",
    "screener",
    "finance",
    "financial-data",
    "market-data",
    "quotes",
    "ticker",
    "portfolio",
    "options-chain",
    "insider-trading",
    "earnings-calendar",
    "dividends",
    "economic-calendar",
    "investing",
    "trading",
    "api",
    "api-client",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "csv-parse": "^6.2.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^5.5.0"
  }
}
